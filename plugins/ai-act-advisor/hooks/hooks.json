{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook.py session-start \"${CLAUDE_PLUGIN_ROOT}/knowledge/VERSION\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" hook.py post-tool-use \"${CLAUDE_PLUGIN_ROOT}/knowledge/VERSION\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
